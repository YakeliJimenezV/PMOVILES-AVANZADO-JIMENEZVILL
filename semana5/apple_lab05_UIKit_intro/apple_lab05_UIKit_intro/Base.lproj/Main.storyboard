<?xml version="1.0" encoding="UTF-8"?>
<document type="com.apple.InterfaceBuilder3.CocoaTouch.Storyboard.XIB" version="3.0" toolsVersion="24506" targetRuntime="iOS.CocoaTouch" propertyAccessControl="none" useAutolayout="YES" useTraitCollections="YES" useSafeAreas="YES" colorMatched="YES" initialViewController="intro-controller">
    <device id="retina6_12" orientation="portrait" appearance="light"/>
    <dependencies>
        <plugIn identifier="com.apple.InterfaceBuilder.IBCocoaTouchPlugin" version="24504"/>
        <capability name="Safe area layout guides" minToolsVersion="9.0"/>
        <capability name="System colors in document resources" minToolsVersion="11.0"/>
        <capability name="documents saved in the Xcode 8 format" minToolsVersion="8.0"/>
    </dependencies>
    <scenes>
        <scene sceneID="intro-scene">
            <objects>
                <viewController id="intro-controller" customClass="ViewController" customModule="apple_lab05_UIKit_intro" customModuleProvider="target" sceneMemberID="viewController">
                    <view key="view" contentMode="scaleToFill" id="intro-view">
                        <rect key="frame" x="0.0" y="0.0" width="393" height="852"/>
                        <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                        <subviews>
                            <label opaque="NO" userInteractionEnabled="NO" contentMode="left" text="Diseño y Desarrollo de Software" textAlignment="center" numberOfLines="0" translatesAutoresizingMaskIntoConstraints="NO" id="intro-label">
                                <rect key="frame" x="24" y="375" width="345" height="26"/>
                                <fontDescription key="fontDescription" type="system" pointSize="21"/>
                                <color key="textColor" systemColor="labelColor"/>
                                <nil key="highlightedColor"/>
                            </label>
                            <label opaque="NO" userInteractionEnabled="NO" contentMode="left" text="Yakeli Jiménez Villalobos" textAlignment="center" numberOfLines="0" translatesAutoresizingMaskIntoConstraints="NO" id="student-label">
                                <rect key="frame" x="24" y="425" width="345" height="72"/>
                                <color key="backgroundColor" red="0.72" green="0.86" blue="1" alpha="1" colorSpace="custom" customColorSpace="sRGB"/>
                                <constraints>
                                    <constraint firstAttribute="height" relation="greaterThanOrEqual" constant="72" id="student-min-height"/>
                                </constraints>
                                <fontDescription key="fontDescription" type="boldSystem" pointSize="32"/>
                                <color key="textColor" red="0.07" green="0.18" blue="0.32" alpha="1" colorSpace="custom" customColorSpace="sRGB"/>
                                <nil key="highlightedColor"/>
                            </label>
                        </subviews>
                        <viewLayoutGuide key="safeArea" id="safe-area"/>
                        <color key="backgroundColor" systemColor="systemBackgroundColor"/>
                        <constraints>
                            <constraint firstItem="intro-label" firstAttribute="leading" secondItem="safe-area" secondAttribute="leading" constant="24" id="intro-leading"/>
                            <constraint firstItem="safe-area" firstAttribute="trailing" secondItem="intro-label" secondAttribute="trailing" constant="24" id="intro-trailing"/>
                            <constraint firstItem="intro-label" firstAttribute="bottom" secondItem="safe-area" secondAttribute="centerY" constant="-24" id="intro-center"/>
                            <constraint firstItem="student-label" firstAttribute="top" secondItem="intro-label" secondAttribute="bottom" constant="24" id="labels-spacing"/>
                            <constraint firstItem="student-label" firstAttribute="leading" secondItem="safe-area" secondAttribute="leading" constant="24" id="student-leading"/>
                            <constraint firstItem="safe-area" firstAttribute="trailing" secondItem="student-label" secondAttribute="trailing" constant="24" id="student-trailing"/>
                            <constraint firstItem="intro-label" firstAttribute="top" relation="greaterThanOrEqual" secondItem="safe-area" secondAttribute="top" constant="16" id="intro-top-boundary"/>
                            <constraint firstItem="safe-area" firstAttribute="bottom" relation="greaterThanOrEqual" secondItem="student-label" secondAttribute="bottom" constant="16" id="student-bottom-boundary"/>
                        </constraints>
                    </view>
                </viewController>
                <placeholder placeholderIdentifier="IBFirstResponder" id="intro-responder" userLabel="First Responder" sceneMemberID="firstResponder"/>
            </objects>
            <point key="canvasLocation" x="0.0" y="0.0"/>
        </scene>
    </scenes>
    <resources>
        <systemColor name="labelColor"><color white="0.0" alpha="1" colorSpace="custom" customColorSpace="genericGamma22GrayColorSpace"/></systemColor>
        <systemColor name="systemBackgroundColor"><color white="1" alpha="1" colorSpace="custom" customColorSpace="genericGamma22GrayColorSpace"/></systemColor>
    </resources>
</document>
