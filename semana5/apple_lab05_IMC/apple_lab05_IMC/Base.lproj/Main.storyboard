                            <constraint id="result-label-center" firstItem="result-label" firstAttribute="centerX" secondItem="safe-area" secondAttribute="centerX" />
                            <constraint id="result-label-leading" firstItem="result-label" firstAttribute="leading" secondItem="safe-area" secondAttribute="leading" constant="24" />
                            <constraint id="result-label-trailing" firstItem="safe-area" firstAttribute="trailing" secondItem="result-label" secondAttribute="trailing" constant="24" />
                            <constraint id="title-top" firstItem="title-label" firstAttribute="top" secondItem="safe-area" secondAttribute="top" constant="24" />
