                            <constraint id="weight-label-centerY" firstItem="weight-label" firstAttribute="centerY" secondItem="weight-field" secondAttribute="centerY" />
                            <constraint id="weight-label-width" firstItem="weight-label" firstAttribute="width" constant="84" />
                            <constraint id="height-field-top" firstItem="height-field" firstAttribute="top" secondItem="weight-field" secondAttribute="bottom" constant="16" />
                            <constraint id="height-field-center" firstItem="height-field" firstAttribute="centerX" secondItem="safe-area" secondAttribute="centerX" constant="50" />
                            <constraint id="height-label-trailing" firstItem="height-field" firstAttribute="leading" secondItem="height-label" secondAttribute="trailing" constant="16" />
