        <capability name="documents saved in the Xcode 8 format" minToolsVersion="8.0" />
    </dependencies>
    <scenes>
        <scene sceneID="intro-scene">
            <objects>
                <viewController id="intro-controller" customClass="ViewController" customModule="apple_lab05_IMC" customModuleProvider="target" sceneMemberID="viewController">
                    <view key="view" contentMode="scaleToFill" id="intro-view">
                        <rect key="frame" x="0.0" y="0.0" width="393" height="852" />
                        <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES" />
                        <subviews>
                            <label opaque="NO" userInteractionEnabled="NO" contentMode="left" translatesAutoresizingMaskIntoConstraints="NO" id="title-label" text="Calcular el IMC de una Persona" textAlignment="center" numberOfLines="1" adjustsFontSizeToFit="YES" minimumScaleFactor="0.65">
                                <rect key="frame" x="24" y="83" width="345" height="24" />
                                <fontDescription key="fontDescription" type="system" pointSize="20" />
                                <color key="textColor" red="0" green="0.4784313725" blue="1" alpha="1" colorSpace="custom" customColorSpace="sRGB" />
                            </label>
                            <label contentMode="left" translatesAutoresizingMaskIntoConstraints="NO" id="weight-label" opaque="NO" userInteractionEnabled="NO" text="Peso (Kg)" numberOfLines="1">
                                <rect key="frame" x="96.5" y="137" width="84" height="21" />
                                <fontDescription key="fontDescription" type="system" pointSize="17" />
                            </label>
                            <textField contentMode="left" translatesAutoresizingMaskIntoConstraints="NO" id="weight-field" opaque="NO" borderStyle="roundedRect" placeholder="Ej. 70">
                                <rect key="frame" x="196.5" y="131" width="100" height="34" />
                                <fontDescription key="fontDescription" type="system" pointSize="17" />
                                <textInputTraits key="textInputTraits" keyboardType="decimalPad" />
                                <constraints>
                                    <constraint firstAttribute="height" constant="34" id="weight-field-height" />
                                    <constraint firstAttribute="width" constant="100" id="weight-field-width" />
                                </constraints>
                            </textField>
                            <label contentMode="left" translatesAutoresizingMaskIntoConstraints="NO" id="height-label" opaque="NO" userInteractionEnabled="NO" text="Altura(m)" numberOfLines="1">
                                <rect key="frame" x="96.5" y="187" width="84" height="21" />
                                <fontDescription key="fontDescription" type="system" pointSize="17" />
                            </label>
                            <textField contentMode="left" translatesAutoresizingMaskIntoConstraints="NO" id="height-field" opaque="NO" borderStyle="roundedRect" placeholder="Ej. 1.75">
                                <rect key="frame" x="196.5" y="181" width="100" height="34" />
                                <fontDescription key="fontDescription" type="system" pointSize="17" />
                                <textInputTraits key="textInputTraits" keyboardType="decimalPad" />
                                <constraints>
                                    <constraint firstAttribute="height" constant="34" id="height-field-height" />
                                    <constraint firstAttribute="width" constant="100" id="height-field-width" />
                                </constraints>
                            </textField>
                            <button contentMode="left" translatesAutoresizingMaskIntoConstraints="NO" id="calculate-button" opaque="NO" buttonType="system">
                                <rect key="frame" x="144.5" y="231" width="104" height="44" />
                                <state key="normal" title="ⓘ Mostrar">
                                    <color key="titleColor" red="0" green="0.4784313725" blue="1" alpha="1" colorSpace="custom" customColorSpace="sRGB" />
                                </state>
                                <connections>
                                    <action selector="CalcularResultado:" destination="intro-controller" eventType="touchUpInside" id="calculate-action" />
                                </connections>
                                <constraints>
                                    <constraint firstAttribute="height" constant="44" id="calculate-button-height" />
                                </constraints>
                            </button>
                            <label opaque="NO" userInteractionEnabled="NO" contentMode="left" translatesAutoresizingMaskIntoConstraints="NO" id="result-heading" text="Resultado IMC" textAlignment="center" numberOfLines="1" adjustsFontSizeToFit="YES" minimumScaleFactor="0.65">
                                <rect key="frame" x="24" y="291" width="345" height="21" />
                                <fontDescription key="fontDescription" type="system" pointSize="17" />
                            </label>
                            <label contentMode="left" translatesAutoresizingMaskIntoConstraints="NO" id="result-label" opaque="NO" userInteractionEnabled="NO" text="Mostrar Resultado" numberOfLines="1" textAlignment="center" adjustsFontSizeToFit="YES" minimumScaleFactor="0.5">
                                <rect key="frame" x="24" y="324" width="345" height="21" />
                                <fontDescription key="fontDescription" type="system" pointSize="17" />
                            </label>
                        </subviews>
                        <viewLayoutGuide key="safeArea" id="safe-area" />
                        <color key="backgroundColor" systemColor="systemBackgroundColor" />
                        <constraints>
                            <constraint id="title-label-center" firstItem="title-label" firstAttribute="centerX" secondItem="safe-area" secondAttribute="centerX" />
                            <constraint id="title-label-leading" firstItem="title-label" firstAttribute="leading" secondItem="safe-area" secondAttribute="leading" constant="24" />
                            <constraint id="title-label-trailing" firstItem="safe-area" firstAttribute="trailing" secondItem="title-label" secondAttribute="trailing" constant="24" />
                            <constraint id="result-heading-center" firstItem="result-heading" firstAttribute="centerX" secondItem="safe-area" secondAttribute="centerX" />
