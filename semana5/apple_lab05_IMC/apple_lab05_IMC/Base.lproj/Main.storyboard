                            <constraint id="button-top" firstItem="calculate-button" firstAttribute="top" secondItem="height-field" secondAttribute="bottom" constant="16" />
                            <constraint id="button-center" firstItem="calculate-button" firstAttribute="centerX" secondItem="safe-area" secondAttribute="centerX" />
                            <constraint id="heading-top" firstItem="result-heading" firstAttribute="top" secondItem="calculate-button" secondAttribute="bottom" constant="16" />
                            <constraint id="result-top" firstItem="result-label" firstAttribute="top" secondItem="result-heading" secondAttribute="bottom" constant="12" />
                        </constraints>
                    </view>
                    <connections>
                        <outlet property="weightTextField" destination="weight-field" id="weightTextField-outlet" />
                        <outlet property="heightTextField" destination="height-field" id="heightTextField-outlet" />
                        <outlet property="resultLabel" destination="result-label" id="resultLabel-outlet" />
                    </connections>
                </viewController>
                <placeholder placeholderIdentifier="IBFirstResponder" id="intro-responder" userLabel="First Responder" sceneMemberID="firstResponder" />
            </objects>
            <point key="canvasLocation" x="0.0" y="0.0" />
